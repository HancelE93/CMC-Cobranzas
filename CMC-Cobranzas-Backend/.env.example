# --- Base de datos (Postgres local vía docker-compose) ---
DATABASE_URL="postgresql://cmc_user:cmc_pass@localhost:5432/cmc_cobranzas_db"

# --- JWT ---
JWT_SECRET=cmc_cobranzas_super_secret_jwt_key_2026_dev_32chars_min
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- CORS / frontend ---
FRONTEND_URL=http://localhost:5173

# --- Cookie httpOnly del refresh token ---
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
COOKIE_PATH=/
COOKIE_PERSISTENT=false

# --- Cloudflare R2 (Almacenamiento de Comprobantes) ---
R2_BUCKET_NAME=cobranzas-cmc-storage
R2_REGION=auto
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=

